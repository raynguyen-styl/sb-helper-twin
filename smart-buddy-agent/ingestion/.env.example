# SMART Buddy ingestion (sb_backfill.py --write) — shared platform stores.

# InfluxDB (history) — write token for the shared bucket; sb_* measurements
INFLUX_URL=https://iot-uat.styl.solutions/influx
INFLUX_TOKEN=CHANGE_ME_sb_write_token
INFLUX_ORG=styl
INFLUX_BUCKET=rtls

# Ditto (current-state twins) — ingestion uses the /ditto-raw path (basic auth, bypasses Keycloak),
# like tree-twin's backfill. (sb-api reads over /ditto.)
DITTO_BASE_URL=https://iot-uat.styl.solutions/ditto-raw
DITTO_USERNAME=ditto
DITTO_PASSWORD=CHANGE_ME
DITTO_NAMESPACE=org.smartbuddy
DITTO_POLICY_ID=user:default-policy

# PII salt — set to pin the hashed card/user tokens across rebuilds (else ephemeral per run)
SB_ID_SALT=

# Input paths inside the container (mounts from docker-compose.sb.yml)
SB_FEB_DIR=/data/feb_data
SB_SCHOOL_GEO=/data/analysis/school_geo.json
SB_ANALYSIS_DIR=/data/analysis
