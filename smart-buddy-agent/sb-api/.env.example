# sb-api — SMART Buddy read API (InfluxDB history + Ditto state)

# InfluxDB — SHARED platform bucket; SMART Buddy history is under sb_* measurements
INFLUX_URL=https://iot-uat.styl.solutions/influx
INFLUX_TOKEN=CHANGE_ME_sb_read_token
INFLUX_ORG=styl
INFLUX_BUCKET=rtls

# Ditto — SMART Buddy twins in the org.smartbuddy namespace (read creds)
DITTO_BASE_URL=https://iot-uat.styl.solutions/ditto
DITTO_USERNAME=CHANGE_ME
DITTO_PASSWORD=CHANGE_ME
DITTO_NAMESPACE=org.smartbuddy

# Service
SB_API_PORT=3320
# Optional Bearer token required on /api/* (leave empty to disable in dev)
SB_API_KEY=

# Fixed playback window (Feb 2026)
POC_START=2026-02-01
POC_END=2026-02-28
