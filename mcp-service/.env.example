# ── smartbuddy-mcp ───────────────────────────────────────────────
# Port — arborist (tree-twin) uses 3500; keep 3501 to avoid collision.
MCP_PORT=3501

# Bearer token the SAM agent must send. Leave EMPTY only for local dev.
# Public/VM deploy MUST set this to a fresh random secret (NOT any tree-twin key).
MCP_API_KEY=

# ClickHouse — the SHARED platform instance `clickhouse`, in-network only (backend network).
# The MCP connects as a DEDICATED READ-ONLY user scoped to the `smartbuddy` database (SELECT only),
# so agent SQL can never touch other demos' tables. Create the db + user with build_feb_clickhouse.py.
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_DB=smartbuddy
CLICKHOUSE_USER=smartbuddy_ro
CLICKHOUSE_PASSWORD=CHANGE_ME_readonly_password

# run_sql result caps + query timeout + per-query memory cap (agent-written SQL — keep bounded so it
# can't compete with the shared instance's live UWB/camera ingest)
MCP_MAX_ROWS_DEFAULT=1000
MCP_MAX_ROWS_HARD=5000
MCP_QUERY_TIMEOUT_MS=15000
MCP_MAX_MEMORY_BYTES=2000000000
