# sb-api — SMART Buddy read API. STANDALONE-DEV reference only.
# In the normal deploy the repo-root docker-compose.yml injects these from the root .env with the
# in-network URL (http://clickhouse:8123). Values below are for `npm start` on a workstation.
#
# Serves the Playback window from the shared ClickHouse `smartbuddy` database as the READ-ONLY user
# (the same store + user the SAM agent uses). No InfluxDB/Ditto.

CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_DB=smartbuddy
CLICKHOUSE_USER=smartbuddy_ro
CLICKHOUSE_PASSWORD=CHANGE_ME_readonly_password

# Service
SB_API_PORT=3320
# Optional Bearer required on /api/* (leave empty to disable in dev)
SB_API_KEY=
