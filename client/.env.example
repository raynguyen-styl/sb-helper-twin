# SMART Buddy frontend — build-time config (Vite bakes VITE_* into the bundle).
# For local dev everything is optional (no login, Playback demo data, chat offline). For the
# live deploy the compose passes these from the repo-root .env. Solace creds ship in the bundle,
# so use LOW-PRIVILEGE demo creds scoped only to the smartbuddy chat topics.

# ── Playback (sb-api) ──────────────────────────────────────────────
# Base URL of the sb-api read service (reads the shared ClickHouse `smartbuddy` db). Same-origin in
# the deploy → use the relative path `/smartbuddy-api` (the frontend nginx proxies it to sb-api).
# Leave EMPTY for offline local dev (Playback uses built-in demo data).
VITE_SB_API_URL=/smartbuddy-api

# ── Keycloak (SHARED realm styl-iot) — gates the whole app (data carries hashed real ids) ──
# Leave VITE_KEYCLOAK_URL empty for local dev (no login). Live: register a `smart-buddy` client
# in the Keycloak admin console + add it to the platform JWT_ALLOWED_CLIENTS, like the other demos.
VITE_KEYCLOAK_URL=https://iot-uat.styl.solutions/auth
VITE_KEYCLOAK_REALM=styl-iot
VITE_KEYCLOAK_CLIENT_ID=smart-buddy

# ── Solace Web Messaging (SMF over wss, usually :443) ──────────────
VITE_SOLACE_URL=wss://YOUR_SOLACE_HOST:443
VITE_SOLACE_VPN=YOUR_VPN
VITE_SOLACE_USER=YOUR_LOW_PRIV_USER
VITE_SOLACE_PASSWORD=YOUR_LOW_PRIV_PASS

# ── SAM chat over Solace ───────────────────────────────────────────
# Default: per-tab topics — each tab auto-gets a UUID segment, no config needed.
# The mesh gateway rule should subscribe to
#   STYL/iot/smartbuddy/system/*/v1/sam/chat/request
# and reply on .../system/{same}/v1/sam/chat/response  (+ optional .../error).
#
# Pin a fixed segment for debugging (disables per-tab isolation):
# VITE_SAM_FIXED_TOPIC_SEGMENT=
#
# Or use explicit shared topics + correlationId (orchestrator must echo it):
# VITE_SAM_QUERY_TOPIC=STYL/iot/smartbuddy/system/shared/v1/sam/chat/request
# VITE_SAM_RESPONSE_TOPIC=STYL/iot/smartbuddy/system/shared/v1/sam/chat/response
# VITE_SAM_ERROR_TOPIC=STYL/iot/smartbuddy/system/shared/v1/sam/chat/error
#
# Deliver a reply to the sole in-flight request if correlationId is missing/wrong:
# VITE_SAM_SINGLE_PENDING_FALLBACK=true
# Reply timeout (ms) — SAM + LLM is slow; default 60000 for Solace.
# VITE_SAM_TIMEOUT_MS=90000

# ── HTTP fallback (used only if the Solace vars above are unset) ────
# VITE_SAM_ENDPOINT=https://smartbuddy-helper-uat.styl.solutions/sam
# VITE_SAM_API_KEY=
