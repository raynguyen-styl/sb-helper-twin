# SMART Buddy frontend — SAM chat assistant config.
# ALL optional: with none set, the chat panel renders and shows "offline"; the
# map/dashboard work unchanged. These values ship in the built JS bundle, so use
# LOW-PRIVILEGE demo Solace creds scoped only to the smartbuddy chat topics.

# ── Playback (sb-api) ──────────────────────────────────────────────
# Base URL of the sb-api read service (InfluxDB/Ditto). Leave EMPTY to use built-in
# demo data so the Playback window works offline. Set to the proxied sb-api for live Feb data.
VITE_SB_API_URL=

# ── Solace Web Messaging (SMF over wss, usually :443) ──────────────
VITE_SOLACE_URL=wss://YOUR_SOLACE_HOST:443
VITE_SOLACE_VPN=YOUR_VPN
VITE_SOLACE_USER=YOUR_LOW_PRIV_USER
VITE_SOLACE_PASSWORD=YOUR_LOW_PRIV_PASS

# ── SAM chat over Solace ───────────────────────────────────────────
# Default: per-tab topics — each tab auto-gets a UUID segment, no config needed.
# The mesh gateway rule should subscribe to
#   STYL/iot/smartbuddy/system/*/v1/sam/chat/request
# and reply on .../system/{same}/v1/sam/chat/response  (+ optional .../error).
#
# Pin a fixed segment for debugging (disables per-tab isolation):
# VITE_SAM_FIXED_TOPIC_SEGMENT=
#
# Or use explicit shared topics + correlationId (orchestrator must echo it):
# VITE_SAM_QUERY_TOPIC=STYL/iot/smartbuddy/system/shared/v1/sam/chat/request
# VITE_SAM_RESPONSE_TOPIC=STYL/iot/smartbuddy/system/shared/v1/sam/chat/response
# VITE_SAM_ERROR_TOPIC=STYL/iot/smartbuddy/system/shared/v1/sam/chat/error
#
# Deliver a reply to the sole in-flight request if correlationId is missing/wrong:
# VITE_SAM_SINGLE_PENDING_FALLBACK=true
# Reply timeout (ms) — SAM + LLM is slow; default 60000 for Solace.
# VITE_SAM_TIMEOUT_MS=90000

# ── HTTP fallback (used only if the Solace vars above are unset) ────
# VITE_SAM_ENDPOINT=https://smart-buddy-uat.styl.solutions/sam
# VITE_SAM_API_KEY=
