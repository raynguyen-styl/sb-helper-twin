# SMART Buddy twin — example .env. Copy to .env and adjust, or run ./bootstrap-env.sh, which writes
# .env (and client/.env) with the same keys. No secret lives here; the backend's are in backend/.env.

SB_FRONTEND_PORT=8097
# frontend build args (baked into the bundle at build time — rebuild after changing any)
VITE_SB_API_URL=/smartbuddy-api
VITE_KEYCLOAK_URL=https://iot-uat.styl.solutions/auth
VITE_KEYCLOAK_REALM=styl-iot
VITE_KEYCLOAK_CLIENT_ID=smart-buddy
# SAM chat transport. These defaults are the shared local Solace that atlantic-platform/common runs on
# every box (not secrets; see common/README.md). Point them at another broker to use it; the values
# ship in the browser bundle, so only ever low-privilege demo credentials here.
VITE_SOLACE_URL=ws://localhost:8008
VITE_SOLACE_VPN=default
VITE_SOLACE_USER=default
VITE_SOLACE_PASSWORD=default
# Demo | Live chat routing (DEPLOY.md "Demo and Live"): the mode a fresh browser opens in (demo | live),
# and each mode's SAM request / response / error topics — the gateway rule on the mesh must match.
# Not secrets. Demo = the uploaded ClickHouse extract + the demo agent; Live = the live agent, no Upload.
VITE_SB_DEFAULT_MODE=demo
VITE_SAM_DEMO_TOPIC_REQUEST=STYL/iot/smartbuddy/system/shared/v1/sam/chat/request
VITE_SAM_DEMO_TOPIC_RESPONSE=STYL/iot/smartbuddy/system/shared/v1/sam/chat/response
VITE_SAM_DEMO_TOPIC_ERROR=STYL/iot/smartbuddy/system/shared/v1/sam/chat/error
VITE_SAM_LIVE_TOPIC_REQUEST=STYL/iot/smartbuddy-live/system/shared/v1/sam/chat/request
VITE_SAM_LIVE_TOPIC_RESPONSE=STYL/iot/smartbuddy-live/system/shared/v1/sam/chat/response
VITE_SAM_LIVE_TOPIC_ERROR=STYL/iot/smartbuddy-live/system/shared/v1/sam/chat/error

# shared docker network (override only if the platform compose project name differs)
BACKEND_NETWORK=solace-pubsub-geo-filtering_backend
