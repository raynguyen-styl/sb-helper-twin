# SMART Buddy — repo-root env for docker compose. Copy to `.env` (gitignored) and fill,
# or run ./bootstrap-env.sh on the VM to assemble it from the sibling repos + fresh secrets.
# docker compose reads the .env in the directory you INVOKE it from — the repo root for both stacks.
#
#   App stack (frontend + sb-api):
#     docker compose up -d --build
#   SAM data agent + one-shot ClickHouse load:
#     docker compose -f docker-compose.yml -f docker-compose.agent.yml up -d --build
#     docker compose -f docker-compose.yml -f docker-compose.agent.yml --profile ingest run --rm ch-ingest
#
# February 2026 is a FIXED month → ONE store: the shared ClickHouse `smartbuddy` database.
# sb-api (Playback) and smartbuddy-mcp (SAM agent) both read it as the read-only user. No InfluxDB/Ditto.

# ── Shared ClickHouse (instance `clickhouse`, in-network on the backend net) ──────────────────────
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_DB=smartbuddy
# Read-only user — created by ch-ingest; sb-api + smartbuddy-mcp connect as this. Pick a password.
CLICKHOUSE_RO_USER=smartbuddy_ro
CLICKHOUSE_RO_PASSWORD=CHANGE_ME_readonly_password
# Admin creds of the SHARED ClickHouse (the atlantic superuser) — used ONLY by ch-ingest to CREATE
# the database + read-only user + load the tables. Not used by sb-api/mcp at runtime.
CLICKHOUSE_ADMIN_USER=atlantic
CLICKHOUSE_ADMIN_PASSWORD=CHANGE_ME_shared_clickhouse_admin_password
# PII salt — pin to keep hashed card/user tokens stable across re-ingests (else ephemeral per run).
SB_ID_SALT=

# ── Frontend build args ───────────────────────────────────────────────────────────────────────
# Host port — 8097 is unused on the VM (frontends run 80/8081–8089/8095/8096, proxy 8080, influx 8086).
SB_FRONTEND_PORT=8097
# Playback API base — SAME-ORIGIN via the frontend nginx (/smartbuddy-api → sb-api). Empty → demo data.
VITE_SB_API_URL=/smartbuddy-api
# Keycloak (shared realm styl-iot). Register a `smart-buddy` client in the admin console + add it to
# the platform JWT_ALLOWED_CLIENTS, like the other demos. Empty VITE_KEYCLOAK_URL → no login (dev).
VITE_KEYCLOAK_URL=https://iot-uat.styl.solutions/auth
VITE_KEYCLOAK_REALM=styl-iot
VITE_KEYCLOAK_CLIENT_ID=smart-buddy
# SAM chat transport — LOW-PRIV demo Solace creds (they ship in the browser bundle).
VITE_SOLACE_URL=wss://YOUR_SOLACE_HOST:443
VITE_SOLACE_VPN=ai-poc-event-broker
VITE_SOLACE_USER=YOUR_LOW_PRIV_USER
VITE_SOLACE_PASSWORD=YOUR_LOW_PRIV_PASS

# ── SAM data agent — mcp-service (docker-compose.agent.yml) ───────────────────────────────────────
# Bearer token the SAM agent sends to the MCP. FRESH random secret — NEVER a tree-twin key.
#   generate:  openssl rand -hex 32
SB_MCP_API_KEY=

# ── Shared platform network ───────────────────────────────────────────────────────────────────
# Override only if the platform compose project name differs from the default.
# BACKEND_NETWORK=solace-pubsub-geo-filtering_backend
