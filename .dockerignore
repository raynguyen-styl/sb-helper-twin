# The build context is the twin repository root, which also holds .env (with the login's client
# secret), its backups and the dev override. None of them may enter the image: the Dockerfile's
# `COPY . .` would otherwise carry them into the build stage.
.env
.env.*
**/.env
**/.env.*
.git
.gitignore
.gitattributes
.sonar
node_modules
dist
*.log
# repository docs and tooling — not part of the app
*.md
bootstrap-env.sh
scripts
docker-compose.yml
# CI and its deploy script (central-specs decision 0009) — not part of the app
deploy
.gitlab-ci.yml
sonar-project.properties
